# Backend Environment Variables
# Copy this to .env and fill in your values (for development)

# Django
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL / Supabase)
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cricket_db

# CORS
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Production settings (for Render/deployment)
# DEBUG=False
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@your-host.subabase.co:5432/postgres?sslmode=require
# ALLOWED_HOSTS=yoursite.onrender.com
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://yoursite.onrender.com
